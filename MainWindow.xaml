<Window x:Class="ScumFreeBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ScumFreeBot (SFB)"
        Height="820"
        Width="1380"
        MinHeight="700"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">


    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#07070A" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0F0F0F" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#2A1116" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A1A1AA" />

        <SolidColorBrush x:Key="AccentBrush" Color="#4A0D0D" />
        <SolidColorBrush x:Key="AccentBrushHover" Color="#FF2D2D" />

        <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#18181B" />
        <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#2A1116" />

        <SolidColorBrush x:Key="InputBrush" Color="#09090B" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#3F1D24" />

        <SolidColorBrush x:Key="DangerGlowBrush" Color="#7F1D1D" />
        <SolidColorBrush x:Key="TableHeaderBrush" Color="#18181B" />
        <SolidColorBrush x:Key="TableRowBrush" Color="#09090B" />
        <SolidColorBrush x:Key="TableAltRowBrush" Color="#0F0F0F" />
        <SolidColorBrush x:Key="TableSelectedBrush" Color="#4A0D0D" />
        <SolidColorBrush x:Key="TableHoverBrush" Color="#2A0C0C" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />


        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                        Background="#4A0D0D"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource AccentBrushHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Root"
                      Background="{TemplateBinding Background}"
                      Width="{TemplateBinding Width}">
                            <Track x:Name="PART_Track"
                           IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                          Opacity="0"
                                          Focusable="False" />
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                          Opacity="0"
                                          Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="Root" Property="Height" Value="12" />
                                <Setter TargetName="Root" Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="12" />
                                <Setter Property="MinHeight" Value="12" />
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#140707" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrushHover}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrushHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SecondaryButtonBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SecondaryButtonHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SecondaryButtonHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,6,0,14" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>

        <Style x:Key="ComboBoxToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border"
                        Background="{StaticResource InputBrush}"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                            <Grid>
                                <Path x:Name="Arrow"
                              Data="M 0 0 L 4 4 L 8 0 Z"
                              Fill="{StaticResource MutedTextBrush}"
                              Width="8"
                              Height="4"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,14,0" />
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="4,2"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource TableHoverBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource TableSelectedBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,6,0,14" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                  Style="{StaticResource ComboBoxToggleButtonStyle}"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

                            <ContentPresenter x:Name="ContentSite"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                      Margin="12,0,40,0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      IsHitTestVisible="False" />

                            <Popup x:Name="Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Fade">
                                <Border Background="{StaticResource InputBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Margin="0,4,0,0"
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="220"
                                          Padding="4"
                                          CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource TableHeaderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="8,6" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource TableSelectedBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource TableRowBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{StaticResource TableAltRowBrush}" />
                </Trigger>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource TableHoverBrush}" />
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource TableSelectedBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource TableRowBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="{StaticResource TableRowBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource TableAltRowBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource DataGridColumnHeaderStyle}" />
            <Setter Property="CellStyle" Value="{StaticResource DataGridCellStyle}" />
            <Setter Property="RowStyle" Value="{StaticResource DataGridRowStyle}" />
            <Setter Property="AlternationCount" Value="2" />
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>

        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid ClipToBounds="False"
                      Margin="0,0,2,0">
                            <Border x:Name="TabBorder"
                            Background="{StaticResource SecondaryButtonBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="0"
                            Padding="16,10"
                            SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ContentSource="Header" />
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SecondaryButtonHoverBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                            </MultiTrigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
        BorderBrush="{StaticResource CardBorderBrush}"
        BorderThickness="1"
        CornerRadius="22"
        Padding="18"
        Background="#0F0F0F">
            <Border.Effect>
                <DropShadowEffect Color="#7F0000"
                          BlurRadius="28"
                          ShadowDepth="0"
                          Opacity="0.35" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="86"
                Height="86"
                CornerRadius="18"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                Background="#050505"
                ClipToBounds="True">
                    <Grid>
                        <Image Source="pack://application:,,,/Assets/logo.png"
                       Stretch="UniformToFill" />

                        <Border BorderBrush="#66EF1B1B"
                        BorderThickness="1"
                        CornerRadius="18" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1"
                    Margin="18,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock Text="SCUM Freebot"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryTextBrush}" />

                    <TextBlock Text="Steuerzentrale für SCUM, AutoHotkey, Chatlog und Bot-Aktionen."
                       Margin="0,6,0,0"
                       Foreground="{StaticResource MutedTextBrush}" />

                    <TextBlock Text="{Binding LastRefreshText}"
                       Margin="0,10,0,0"
                       Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <Button Content="Refresh"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="RefreshButton_Click" />

                    <Button Content="Speichern"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="10,6,0,0"
                    Click="SaveSettingsButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2"
      Margin="0,0,0,14"
      Visibility="{Binding ShowAdminWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="2"
            Background="#2A0C0C"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Bot läuft nicht als Administrator"
                           Foreground="#FCA5A5"
                           FontSize="15"
                           FontWeight="SemiBold" />

                        <TextBlock Text="SCUM nimmt Tasteneingaben möglicherweise nicht an. Starte den Bot als Administrator, damit AutoHotkey zuverlässig schreiben kann."
                           Foreground="#FECACA"
                           FontSize="13"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="1"
                    Content="Als Administrator neu starten"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Click="RestartAsAdminButton_Click" />
                </Grid>
            </Border>
        </Grid>

        <TabControl Grid.Row="4"
            Background="Transparent"
            BorderThickness="0"
            Padding="0">
            <TabItem Header="Dashboard" Style="{StaticResource TabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorderStyle}"
                    Margin="0,14,0,0">
                            <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Versionsprüfung"
                       Style="{StaticResource SectionHeaderStyle}" />

                                <TextBlock Margin="0,8,0,0"
                       Foreground="{StaticResource MutedTextBrush}">
                <Run Text="Installierte Version: " />
                <Run Text="{Binding CurrentVersionText, Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock Margin="0,4,0,0"
                       Foreground="{StaticResource MutedTextBrush}">
                <Run Text="Neueste Version: " />
                <Run Text="{Binding LatestVersionText, Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock Text="{Binding UpdateStatusText}"
                       Margin="0,8,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap" />

                                    <Border Background="#2A0C0C"
        BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10"
                    Margin="0,10,0,0"
                    Visibility="{Binding UpdateAvailableVisibility}">
                                    <TextBlock Text="Eine neue Version ist verfügbar."
                          Foreground="#FECACA"
                           FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="1"
                Content="Prüfen"
                Style="{StaticResource SecondaryButtonStyle}"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Click="CheckForUpdatesButton_Click" />

                            <Button Grid.Column="2"
                Content="Download"
                Style="{StaticResource SecondaryButtonStyle}"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Visibility="{Binding UpdateAvailableVisibility}"
                Click="OpenUpdateDownloadButton_Click" />

                            <Button Grid.Column="3"
                Content="Patchnotes"
                Style="{StaticResource SecondaryButtonStyle}"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Visibility="{Binding UpdateAvailableVisibility}"
                Click="OpenPatchNotesButton_Click" />
                        </Grid>
                    </Border>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="SCUM Status" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Text="Prüft, ob der SCUM-Prozess läuft."
                                           Margin="0,8,0,14"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <Border Background="{Binding ScumStatusBackground}"
                                        CornerRadius="9"
                                        Padding="12,6"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding ScumStatusText}"
                                               Foreground="White"
                                               FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Text="{Binding ScumDetails}"
                                           Margin="0,14,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="AutoHotkey Status" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Text="Prüft EXE und Script-Pfad."
                                           Margin="0,8,0,14"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <Border Background="{Binding AhkStatusBackground}"
                                        CornerRadius="9"
                                        Padding="12,6"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding AhkStatusText}"
                                               Foreground="White"
                                               FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Text="{Binding AhkDetails}"
                                           Margin="0,14,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ScriptDetails}"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Chatlog Status" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Text="Zeigt den Zustand des aktuell gefundenen Logs."
                                           Margin="0,8,0,14"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <Border Background="{Binding ChatLogStatusBackground}"
                                        CornerRadius="9"
                                        Padding="12,6"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding ChatLogStatusText}"
                                               Foreground="White"
                                               FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Text="{Binding ChatLogDetails}"
                                           Margin="0,14,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Bot Status" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Text="Letzte erkannte Bot-Aktion oder Command-Reaktion."
                                           Margin="0,8,0,14"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                    <Border Background="{StaticResource InputBrush}"
                                        BorderBrush="{StaticResource InputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="14">
                                    <TextBlock Text="{Binding BotStatusText}"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Befehle" Style="{StaticResource TabItemStyle}">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="Steuerungszentrale" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Text="Spielerbefehle anlegen, aktivieren und begrenzen. Die Admins müssen keine JSON-Dateien bearbeiten."
                                           Margin="0,8,0,16"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" />

                                <Button Content="+ Neuer Befehl"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="AddCommandRuleButton_Click" />
                                <Button Content="Ausgewählten löschen"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="DeleteCommandRuleButton_Click" />
                            </StackPanel>

                            <ListBox ItemsSource="{Binding CommandRules}"
         SelectedItem="{Binding SelectedCommandRule, Mode=TwoWay}"
         DisplayMemberPath="DisplayName"
         Margin="0,18,0,0"
         Background="{StaticResource InputBrush}"
         Foreground="{StaticResource PrimaryTextBrush}"
         BorderBrush="{StaticResource InputBorderBrush}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10,8" />
                                        <Setter Property="Margin" Value="4,2" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource TableHoverBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource TableSelectedBrush}" />
                                                            <Setter Property="Foreground" Value="White" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" DataContext="{Binding SelectedCommandRule}">
                                    <CheckBox Content="Befehl aktiv"
                                              IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Foreground="{StaticResource PrimaryTextBrush}"
                                              Margin="0,0,0,14" />

                                    <TextBlock Text="Eingabe vom Spieler" Style="{StaticResource LabelStyle}" />
                                    <TextBox Text="{Binding Trigger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextBoxStyle}" />

                                    <TextBlock Text="Ablaufskript" Style="{StaticResource LabelStyle}" />
                                    <TextBox Text="{Binding ScriptFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextBoxStyle}" />

                                    <TextBlock Text="Zone" Style="{StaticResource LabelStyle}" />
                                    <TextBox Text="{Binding Zone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextBoxStyle}"
                                             ToolTip="Zone-Auswahl kommt später. Feld ist schon vorbereitet." />
                                </StackPanel>

                                <StackPanel Grid.Column="2" DataContext="{Binding SelectedCommandRule}">
                                    <TextBlock Text="Ausführungsregel" Style="{StaticResource LabelStyle}" />
                                    <ComboBox ItemsSource="{Binding DataContext.RunModeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding RunMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource ComboBoxStyle}" />

                                    <TextBlock Text="Stunden / Cooldown" Style="{StaticResource LabelStyle}" />
                                    <TextBox Text="{Binding CooldownHours, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextBoxStyle}" />

                                    <TextBlock Text="Ablehnungsnachricht" Style="{StaticResource LabelStyle}" />
                                    <TextBox Text="{Binding DenyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextBoxStyle}"
                                             AcceptsReturn="True"
                                             Height="82"
                                             TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="2"
        Background="#0F0F0F"
        BorderBrush="{StaticResource AccentBrush}"
        BorderThickness="1"
        CornerRadius="12"
        Padding="14"
        Margin="0"
        Visibility="{Binding ShowAdminWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Script-Ablauf"
                                                   Style="{StaticResource LabelStyle}"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Content="Hilfe"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="12,6"
                                                Margin="8,0,0,0"
                                                Click="ShowCommandScriptHelpButton_Click" />
                                    </Grid>
                                    <TextBox Grid.Row="1"
                                             Text="{Binding SelectedCommandScriptText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{StaticResource InputBrush}"
                                             Foreground="{StaticResource PrimaryTextBrush}"
                                             BorderThickness="0"
                                             FontFamily="Consolas"
                                             FontSize="13"
                                             AcceptsReturn="True"
                                             AcceptsTab="True"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             TextWrapping="NoWrap" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                <TextBlock Text="{Binding CommandCenterStatusText}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,16,0" />
                                <Button Content="Speichern"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="SaveCommandCenterButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Ausführungen" Style="{StaticResource TabItemStyle}">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Ausgeführte Spielerbefehle"
                               Style="{StaticResource SectionHeaderStyle}" />

                                <TextBlock Text="Hier siehst du, welche Spieler welche begrenzten Befehle bereits benutzt haben. Einzelne Timer oder Einmal-Sperren können hier zurückgesetzt werden."
                               Margin="0,8,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Column="1"
                        Content="Aktualisieren"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Click="RefreshPlayerCommandUsagesButton_Click" />

                            <Button Grid.Column="2"
                        Content="Eintrag zurücksetzen"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Click="ResetSelectedPlayerCommandUsageButton_Click" />

                            <Button Grid.Column="3"
                        Content="Spieler komplett zurücksetzen"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Click="ResetAllPlayerCommandUsagesButton_Click" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DataGrid Grid.Row="0"
          ItemsSource="{Binding PlayerCommandUsages}"
          SelectedItem="{Binding SelectedPlayerCommandUsage, Mode=TwoWay}"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          IsReadOnly="True"
          Style="{StaticResource DataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Spieler"
                                            Binding="{Binding DisplayPlayerName}"
                                            Width="2*" />

                                    <DataGridTextColumn Header="SteamId / Key"
                                            Binding="{Binding PlayerKey}"
                                            Width="2*" />

                                    <DataGridTextColumn Header="Befehl"
                                            Binding="{Binding Trigger}"
                                            Width="*" />

                                    <DataGridTextColumn Header="Anzahl"
                                            Binding="{Binding UseCount}"
                                            Width="80" />

                                    <DataGridTextColumn Header="Letzte Ausführung"
                                            Binding="{Binding LastUsedText}"
                                            Width="170" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="1"
                           Text="{Binding PlayerCommandUsageStatusText}"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,12,0,0" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>


            <TabItem Header="Logs" Style="{StaticResource TabItemStyle}">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Server Chatlog" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="Vorschau der letzten Zeilen aus dem aktuellen Chatlog."
                                       Margin="0,8,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ChatLogPreview}"
                                       Foreground="#E2E8F0"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       TextWrapping="NoWrap" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Einstellungen" Style="{StaticResource TabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Pfade" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Text="AutoHotkey, Script und lokaler Chatlog-Ordner."
                                           Margin="0,8,0,20"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" />

                                <TextBlock Text="AutoHotkey EXE Pfad" Style="{StaticResource LabelStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding AutoHotkeyPath, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextBoxStyle}" />
                                    <Button Grid.Column="1"
                                            Content="EXE wählen"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="12,6,0,14"
                                            Click="BrowseAhkExeButton_Click" />
                                </Grid>

                                <TextBlock Text="AHK Script Pfad" Style="{StaticResource LabelStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding ScriptPath, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextBoxStyle}" />
                                    <Button Grid.Column="1"
                                            Content="Script wählen"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="12,6,0,14"
                                            Click="BrowseScriptButton_Click" />
                                </Grid>

                                <TextBlock Text="Server Chatlog Ordner" Style="{StaticResource LabelStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding ChatLogDirectory, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextBoxStyle}" />
                                    <Button Grid.Column="1"
                                            Content="Ordner wählen"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="12,6,0,14"
                                            Click="BrowseChatLogDirectoryButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Remote Logs (FTP / SFTP)" Style="{StaticResource SectionHeaderStyle}" />
                                    <TextBlock Text="Hier stellst du ein, ob SFB Logs lokal, per FTP oder per SFTP beziehen soll."
                       Margin="0,8,0,20"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap" />

                                    <TextBlock Text="Quelle" Style="{StaticResource LabelStyle}" />
                                    <ComboBox SelectedValue="{Binding LogSourceMode}"
                      SelectedValuePath="Content"
                      Style="{StaticResource ComboBoxStyle}">
                                        <ComboBoxItem Content="Local" />
                                        <ComboBoxItem Content="FTP" />
                                        <ComboBoxItem Content="SFTP" />
                                    </ComboBox>

                                    <CheckBox Content="Remote Sync aktiv"
                      IsChecked="{Binding RemoteSyncEnabled}"
                      Foreground="{StaticResource PrimaryTextBrush}"
                      Margin="0,0,0,16" />

                                    <TextBlock Text="Host" Style="{StaticResource LabelStyle}" />
                                    <TextBox Text="{Binding RemoteHost, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource TextBoxStyle}" />

                                    <TextBlock Text="Port" Style="{StaticResource LabelStyle}" />
                                    <TextBox Text="{Binding RemotePort, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource TextBoxStyle}"
                     Width="120"
                     HorizontalAlignment="Left" />

                                    <TextBlock Text="Benutzername" Style="{StaticResource LabelStyle}" />
                                    <TextBox Text="{Binding RemoteUsername, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource TextBoxStyle}" />

                                    <TextBlock Text="Passwort" Style="{StaticResource LabelStyle}" />
                                    <PasswordBox x:Name="RemotePasswordBox"
                         Margin="0,6,0,14"
                         Padding="12,10"
                         Background="{StaticResource InputBrush}"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         BorderBrush="{StaticResource InputBorderBrush}"
                         BorderThickness="1"
                         PasswordChanged="RemotePasswordBox_PasswordChanged" />

                                    <TextBlock Text="Remote Logs Pfad" Style="{StaticResource LabelStyle}" />
                                    <TextBox Text="{Binding RemoteLogsPath, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource TextBoxStyle}" />

                                    <TextBlock Text="Sync-Intervall (Sekunden)" Style="{StaticResource LabelStyle}" />
                                    <TextBox Text="{Binding RemoteSyncIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"
         Style="{StaticResource TextBoxStyle}"
         Width="120"
         HorizontalAlignment="Left" />

                                    <Button Content="Jetzt synchronisieren"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="RunRemoteSyncButton_Click" />

                                    <Border Background="{Binding RemoteSyncStatusBackground}"
                    CornerRadius="9"
                    Padding="12,6"
                    Margin="0,18,0,10"
                    HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding RemoteSyncStatusText}"
                           Foreground="White"
                           FontWeight="SemiBold" />
                                    </Border>

                                    <TextBlock Text="{Binding RemoteSyncDetails}"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap" />

                                    <Separator Margin="0,20,0,20" Background="#1F2937" />

                                    <TextBlock Text="Lokale Überwachung" Style="{StaticResource SectionHeaderStyle}" />
                                    <TextBlock Text="Grundlegende Prüfintervalle und Verhalten."
                       Margin="0,8,0,20"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap" />

                                    <CheckBox Content="Automatische Überwachung aktiv"
                      IsChecked="{Binding AutoRefreshEnabled}"
                      Foreground="{StaticResource PrimaryTextBrush}"
                      Margin="0,0,0,16" />

                                    <TextBlock Text="Refresh-Intervall (Sekunden)" Style="{StaticResource LabelStyle}" />
                                    <TextBox Width="100"
                     HorizontalAlignment="Left"
                     Text="{Binding RefreshIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource TextBoxStyle}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>