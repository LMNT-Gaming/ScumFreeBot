<Application x:Class="ScumFreeBot.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ScumFreeBot"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#07070A" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#101014" />
        <SolidColorBrush x:Key="CardSecondaryBrush" Color="#18181B" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#2A1116" />

        <SolidColorBrush x:Key="AccentBrush" Color="#EF101B" />
        <SolidColorBrush x:Key="AccentBrushHover" Color="#FF2D2D" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#2A0C0C" />

        <SolidColorBrush x:Key="WarningBrush" Color="#EF1B1B" />
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />

        <SolidColorBrush x:Key="MutedTextBrush" Color="#A1A1AA" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F8FAFC" />

        <SolidColorBrush x:Key="InputBrush" Color="#09090B" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#3F1D24" />
        <SolidColorBrush x:Key="TableHeaderBrush" Color="#18181B" />
        <SolidColorBrush x:Key="TableRowBrush" Color="#09090B" />
        <SolidColorBrush x:Key="TableAltRowBrush" Color="#101014" />
        <SolidColorBrush x:Key="TableSelectedBrush" Color="#4A0D0D" />
        <SolidColorBrush x:Key="TableHoverBrush" Color="#2A0C0C" />

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource CardSecondaryBrush}" />
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,6,0,14" />
        </Style>
    </Application.Resources>
</Application>
